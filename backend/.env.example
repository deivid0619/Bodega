# Copia este archivo a .env y ajusta los valores.

# Local: sqlite:///./bodega.db
# Produccion (Supabase/Postgres): postgresql://usuario:password@host:5432/postgres
DATABASE_URL=sqlite:///./bodega.db

# Genera uno propio: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Codigo que se pide al crear una cuenta nueva, para que no se registre cualquiera
REGISTRATION_CODE=pigmalion

# Usuario administrador que se crea automaticamente la primera vez que arranca la API
ADMIN_EMAIL=admin@pigmalionmoto.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambiar123

# Dominios del frontend que pueden llamar a esta API, separados por coma
CORS_ORIGINS=http://localhost:5173
